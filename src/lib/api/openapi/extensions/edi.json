{
  "components": {
    "schemas": {
      "BasicErrorResponseV1": {
        "description": "The error body of every UI API operation (core and extensions).",
        "properties": {
          "error": {
            "description": "The error message (the same as message; kept for clients of UI API 1.0 to 1.5).",
            "type": "string"
          },
          "code": {
            "description": "A stable, machine-readable code. Well-known values: BAD_REQUEST (400), UNAUTHENTICATED (401),\nPERMISSION_DENIED (403), NOT_FOUND (404), CONFLICT (409), RATE_LIMITED (429), INTERNAL_ERROR (500),\nERROR (other). Extensions may add codes; treat an unknown code by the HTTP status. Since 1.6.0.",
            "type": "string"
          },
          "message": {
            "description": "A message to show the user. Since 1.6.0.",
            "type": "string"
          },
          "fieldErrors": {
            "description": "Errors about particular request fields, when known. Since 1.6.0.",
            "items": {
              "properties": {
                "field": {
                  "description": "The field (or parameter) name.",
                  "type": "string"
                },
                "message": {
                  "description": "The error about that field.",
                  "type": "string"
                },
                "code": {
                  "description": "An optional machine-readable code, e.g. REQUIRED, TOO_LONG, PATTERN.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "traceId": {
            "description": "Identifies this request in the server logs (also the X-QQQ-Trace-Id response header); quote it when reporting a problem. Since 1.6.0.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiAckV1": {
        "description": "Concatenated acknowledgement previews; type is 997, 999, TA1, CONTRL, NONE or MIXED. text is null for PHI.",
        "properties": {
          "text": {
            "nullable": true,
            "type": "string"
          },
          "type": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiAssociationV1": {
        "description": "Direct QQQ association and its target fields.",
        "properties": {
          "fields": {
            "items": {
              "$ref": "#/components/schemas/EdiFieldV1"
            },
            "type": "array"
          },
          "label": {
            "nullable": true,
            "type": "string"
          },
          "name": {
            "nullable": true,
            "type": "string"
          },
          "table": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiDiffV1": {
        "description": "Only differing records are returned. Both lists are empty for PHI.",
        "properties": {
          "againstExpected": {
            "items": {
              "$ref": "#/components/schemas/EdiDifferenceV1"
            },
            "type": "array"
          },
          "againstPreviousRevision": {
            "items": {
              "$ref": "#/components/schemas/EdiDifferenceV1"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EdiDifferenceV1": {
        "description": "One document comparison; documentIndex is zero based.",
        "properties": {
          "after": {
            "additionalProperties": true,
            "nullable": true,
            "type": "object"
          },
          "before": {
            "description": "Expected JSON or a previous mapped record.",
            "nullable": true
          },
          "documentIndex": {
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "EdiElementV1": {
        "description": "Element or composite component; codes contain at most 200 active codes in lexical order.",
        "properties": {
          "codeListId": {
            "nullable": true,
            "type": "integer"
          },
          "codes": {
            "items": {
              "nullable": true,
              "type": "string"
            },
            "type": "array"
          },
          "component": {
            "nullable": true,
            "type": "integer"
          },
          "id": {
            "nullable": true,
            "type": "string"
          },
          "maxLength": {
            "nullable": true,
            "type": "integer"
          },
          "minLength": {
            "nullable": true,
            "type": "integer"
          },
          "name": {
            "nullable": true,
            "type": "string"
          },
          "position": {
            "nullable": true,
            "type": "integer"
          },
          "type": {
            "nullable": true,
            "type": "string"
          },
          "usage": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiErrorV1": {
        "description": "Deprecated since 1.1.0: errors use BasicErrorResponseV1.",
        "properties": {
          "error": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiFieldV1": {
        "description": "QQQ target field metadata.",
        "properties": {
          "label": {
            "nullable": true,
            "type": "string"
          },
          "name": {
            "nullable": true,
            "type": "string"
          },
          "possibleValueSourceName": {
            "nullable": true,
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiFindingV1": {
        "description": "Value-free diagnostic. PHI messages are generic; only positions and codes are retained.",
        "properties": {
          "code": {
            "nullable": true,
            "type": "string"
          },
          "elementPosition": {
            "nullable": true,
            "type": "integer"
          },
          "loopId": {
            "nullable": true,
            "type": "string"
          },
          "message": {
            "nullable": true,
            "type": "string"
          },
          "segmentId": {
            "nullable": true,
            "type": "string"
          },
          "segmentPosition": {
            "nullable": true,
            "type": "integer"
          },
          "severity": {
            "nullable": true,
            "type": "string"
          },
          "snipLevel": {
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "EdiGuideTreeV1": {
        "description": "Ordered guide tree. Root segments are outside loops; nested loops retain parent scope.",
        "properties": {
          "loops": {
            "items": {
              "$ref": "#/components/schemas/EdiLoopV1"
            },
            "type": "array"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/EdiSegmentV1"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EdiLoopV1": {
        "description": "Guide loop, nested within its parent; repeat is the maximum occurrence count.",
        "properties": {
          "id": {
            "nullable": true,
            "type": "string"
          },
          "loops": {
            "items": {
              "$ref": "#/components/schemas/EdiLoopV1"
            },
            "type": "array"
          },
          "repeat": {
            "nullable": true,
            "type": "integer"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/EdiSegmentV1"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EdiParseV1": {
        "description": "Counts of wire interchanges, groups and documents.",
        "properties": {
          "documents": {
            "nullable": true,
            "type": "integer"
          },
          "groups": {
            "nullable": true,
            "type": "integer"
          },
          "interchanges": {
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "EdiPreviewRequestV1": {
        "description": "mapId is required. Supply exactly one of sampleId or sampleBase64. Uploads are at most 5 MiB decoded, stored encrypted. ruleOverrides replaces the whole rule set in memory. CURRENT (default) uses the newest active guide in the pinned guide family; ORIGINAL uses the pinned guide.",
        "properties": {
          "guideRevision": {
            "enum": [
              "CURRENT",
              "ORIGINAL"
            ],
            "nullable": true,
            "type": "string"
          },
          "mapId": {
            "nullable": true,
            "type": "integer"
          },
          "ruleOverrides": {
            "items": {
              "$ref": "#/components/schemas/EdiRuleV1"
            },
            "nullable": true,
            "type": "array"
          },
          "sampleBase64": {
            "format": "byte",
            "maxLength": 6990508,
            "nullable": true,
            "type": "string"
          },
          "sampleId": {
            "nullable": true,
            "type": "integer"
          },
          "sampleName": {
            "maxLength": 255,
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiPreviewV1": {
        "description": "Parse, validate, acknowledge and map without target writes. PHI suppresses result, ack text, and both diffs.",
        "properties": {
          "ack": {
            "$ref": "#/components/schemas/EdiAckV1"
          },
          "diff": {
            "$ref": "#/components/schemas/EdiDiffV1"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/EdiFindingV1"
            },
            "type": "array"
          },
          "parse": {
            "$ref": "#/components/schemas/EdiParseV1"
          },
          "phiSuppressed": {
            "type": "boolean"
          },
          "result": {
            "$ref": "#/components/schemas/EdiResultV1",
            "nullable": true
          }
        },
        "type": "object"
      },
      "EdiRecordV1": {
        "description": "Field values and recursively associated records. Values use the target table field types.",
        "properties": {
          "associations": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/EdiRecordV1"
              },
              "type": "array"
            },
            "type": "object"
          },
          "values": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "type": "object"
      },
      "EdiResultV1": {
        "description": "Mapped records in document order; no target writes.",
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/EdiRecordV1"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EdiRuleErrorsV1": {
        "description": "Correlate errors using zero-based index, optional id and sequence.",
        "properties": {
          "errors": {
            "items": {
              "nullable": true,
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "nullable": true,
            "type": "integer"
          },
          "index": {
            "nullable": true,
            "type": "integer"
          },
          "sequence": {
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "EdiRuleV1": {
        "description": "Map rule. id is optional for unsaved rules. transformArgs is a JSON object encoded as a string, as in core table CRUD.",
        "properties": {
          "condition": {
            "nullable": true,
            "type": "string"
          },
          "defaultValue": {
            "nullable": true,
            "type": "string"
          },
          "ediPath": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "nullable": true,
            "type": "integer"
          },
          "qqqPath": {
            "nullable": true,
            "type": "string"
          },
          "required": {
            "nullable": true,
            "type": "boolean"
          },
          "sequence": {
            "nullable": true,
            "type": "integer"
          },
          "transform": {
            "nullable": true,
            "type": "string"
          },
          "transformArgs": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiSegmentV1": {
        "description": "Segment definition in guide sequence order.",
        "properties": {
          "elements": {
            "items": {
              "$ref": "#/components/schemas/EdiElementV1"
            },
            "type": "array"
          },
          "id": {
            "nullable": true,
            "type": "string"
          },
          "max": {
            "nullable": true,
            "type": "integer"
          },
          "min": {
            "nullable": true,
            "type": "integer"
          },
          "name": {
            "nullable": true,
            "type": "string"
          },
          "position": {
            "nullable": true,
            "type": "string"
          },
          "usage": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiTargetV1": {
        "description": "Target metadata visible to the caller, current rules and registered transforms.",
        "properties": {
          "associations": {
            "items": {
              "$ref": "#/components/schemas/EdiAssociationV1"
            },
            "type": "array"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/EdiFieldV1"
            },
            "type": "array"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/EdiRuleV1"
            },
            "type": "array"
          },
          "table": {
            "nullable": true,
            "type": "string"
          },
          "transforms": {
            "items": {
              "$ref": "#/components/schemas/EdiTransformV1"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EdiTransformV1": {
        "description": "Registered transform and JSON Schema describing its string-valued arguments.",
        "properties": {
          "argumentSchema": {
            "additionalProperties": true,
            "description": "JSON Schema: type, properties, required and additionalProperties. All transform arguments are strings.",
            "type": "object"
          },
          "name": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EdiValidateRequestV1": {
        "description": "rules is required and may be empty; rules are never persisted.",
        "properties": {
          "rules": {
            "items": {
              "$ref": "#/components/schemas/EdiRuleV1"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EdiValidationV1": {
        "description": "One result per submitted rule, including rules with no errors.",
        "properties": {
          "rules": {
            "items": {
              "$ref": "#/components/schemas/EdiRuleErrorsV1"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionUuidCookie": {
        "description": "The session cookie set by POST /qqq/v1/manageSession (web clients).",
        "in": "cookie",
        "name": "sessionUUID",
        "type": "apiKey"
      },
      "bearerAuth": {
        "bearerFormat": "JWT or session UUID",
        "description": "`Authorization: Bearer <token>`, where the token is either\n- an OAuth2 access token (a signed JWT) issued by the app's identity provider to the app's client,\n  or to its native client (`values.nativeClientId` in GET /qqq/v1/metaData/authentication), for\n  example from the device-authorization grant or auth-code + PKCE. It is verified against the\n  provider's keys (issuer, audience, expiry, signature) and gives the same user and permissions\n  as signing in on the web. When it expires (401), refresh it at the provider and retry; or\n- a session UUID returned by POST /qqq/v1/manageSession, which the server keeps refreshed.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauth2": {
        "description": "The app's OAuth2 / OpenID Connect provider. The real endpoints come from the provider's discovery\ndocument: `{values.baseUrl}.well-known/openid-configuration`, with values from\nGET /qqq/v1/metaData/authentication. Native clients use `values.nativeClientId` (a public client)\nwith auth-code + PKCE (loopback or custom-scheme redirect URI registered at the provider) or the\ndevice-authorization grant (`device_authorization_endpoint`, RFC 8628), then send the access token\nas `Authorization: Bearer`.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/authorize",
            "scopes": {
              "email": "Email address",
              "offline_access": "A refresh token, to renew the access token without signing in again",
              "openid": "OpenID Connect sign-in",
              "profile": "Name, username and groups (permissions come from the groups)"
            },
            "tokenUrl": "/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "contact": {
      "email": "contact@kingsrook.com"
    },
    "description": "EDI sandbox and mapper, using the signed-in user's permissions.",
    "title": "QQQ Middleware API extension: edi",
    "version": "1.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/qqq/v1/qbit/edi/guides/{guideId}/tree": {
      "get": {
        "description": "Read the guide tree. Uses the caller session and table read permissions. Preview also requires edi.map.preview. Rule writes use core table CRUD.",
        "operationId": "getQbitEdiGuidesByGuideIdTree",
        "parameters": [
          {
            "description": "Positive record identifier.",
            "in": "path",
            "name": "guideId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Invalid request or sample exceeds 5 MiB"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Sign in required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Permission denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Missing or invisible record"
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EdiGuideTreeV1"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Host HTTP request size limit exceeded"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Conflict with the current state, e.g. an edit conflict or an invalid transition (code CONFLICT)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Too many requests (code RATE_LIMITED); retry later."
          }
        },
        "security": [
          {
            "sessionUuidCookie": [
              "N/A"
            ]
          },
          {
            "bearerAuth": [
              "N/A"
            ]
          },
          {
            "oauth2": [
              "openid",
              "profile",
              "email"
            ]
          }
        ],
        "summary": "Read the guide tree",
        "tags": [
          "edi"
        ]
      }
    },
    "/qqq/v1/qbit/edi/maps/{mapId}/target": {
      "get": {
        "description": "Read target metadata and map rules. Uses the caller session and table read permissions. Preview also requires edi.map.preview. Rule writes use core table CRUD.",
        "operationId": "getQbitEdiMapsByMapIdTarget",
        "parameters": [
          {
            "description": "Positive record identifier.",
            "in": "path",
            "name": "mapId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Invalid request or sample exceeds 5 MiB"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Sign in required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Permission denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Missing or invisible record"
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EdiTargetV1"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Host HTTP request size limit exceeded"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Conflict with the current state, e.g. an edit conflict or an invalid transition (code CONFLICT)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Too many requests (code RATE_LIMITED); retry later."
          }
        },
        "security": [
          {
            "sessionUuidCookie": [
              "N/A"
            ]
          },
          {
            "bearerAuth": [
              "N/A"
            ]
          },
          {
            "oauth2": [
              "openid",
              "profile",
              "email"
            ]
          }
        ],
        "summary": "Read target metadata and map rules",
        "tags": [
          "edi"
        ]
      }
    },
    "/qqq/v1/qbit/edi/sandbox/preview": {
      "post": {
        "description": "Preview an encrypted sample with optional unsaved rules. Uses the caller session and table read permissions. Preview also requires edi.map.preview. Rule writes use core table CRUD.",
        "operationId": "postQbitEdiSandboxPreview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EdiPreviewRequestV1"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Invalid request or sample exceeds 5 MiB"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Sign in required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Permission denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicErrorResponseV1"
                }
              }
            },
            "description": "Missing or invisible record"
          },
          "200": {
            "content": {
