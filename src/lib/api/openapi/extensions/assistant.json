        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "Disabled, not configured, or the kill switch is on"
     }
    },
    "security": [
     {
      "sessionUuidCookie": [
       "N/A"
