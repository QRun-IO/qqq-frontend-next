   "post": {
    "description": "Start a conversation",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "description": "Optional title and the page context it starts from.",
        "properties": {
         "context": {
          "additionalProperties": true,
          "description": "route, tableName, recordId, filter, selectedIds.",
          "type": "object"
         },
         "title": {
          "type": "string"
         }
        },
        "type": "object"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantConversationV1"
        }
       }
      },
      "description": "Successful Response"
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "Invalid input"
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "No access to the assistant"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "Not found (or not the user's own)"
     },
     "409": {
      "content": {
       "application/json": {
