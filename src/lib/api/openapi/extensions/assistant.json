{
 "components": {
  "schemas": {
   "AssistantAccessResponseV1": {
    "description": "Explain access: per table, the user's UI permissions, the assistant's data access, and each tool's verdict.",
    "properties": {
     "tables": {
      "items": {
       "additionalProperties": true,
       "description": "table, label, dataAccess, dataAccessSource, ui {visible, read, insert, edit, delete}, operations [{tool, operation, allowed, reason}].",
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "AssistantActionV1": {
    "description": "A write the assistant proposed and its state.",
    "properties": {
     "expiresAt": {
      "nullable": true,
      "type": "string"
     },
     "href": {
      "description": "After a confirm: the written record's /app link.",
      "nullable": true,
      "type": "string"
     },
     "httpStatus": {
      "description": "The UI API status of the write.",
      "nullable": true,
      "type": "integer"
     },
     "id": {
      "type": "integer"
     },
     "message": {
      "description": "After a confirm: what happened.",
      "nullable": true,
      "type": "string"
     },
     "outcome": {
      "description": "After a confirm: the tool outcome.",
      "nullable": true,
      "type": "string"
     },
     "recordId": {
      "nullable": true,
      "type": "string"
     },
     "resultSummary": {
      "nullable": true,
      "type": "string"
     },
     "status": {
      "description": "PENDING, RUNNING, EXECUTED, FAILED, REJECTED or EXPIRED.",
      "type": "string"
     },
     "summary": {
      "type": "string"
     },
     "tableName": {
      "type": "string"
     },
     "toolName": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "AssistantActiveTurnsResponseV1": {
    "description": "The caller's active runs, newest first; stale leases are reaped.",
    "properties": {
     "turns": {
      "items": {
       "description": "An active assistant run.",
       "properties": {
        "assistantMessageId": {
         "type": "integer"
        },
        "concurrencyMode": {
         "description": "SUPERSEDE or CONCURRENT.",
         "type": "string"
        },
        "conversationId": {
         "type": "integer"
        },
        "elapsedMs": {
         "type": "integer"
        },
        "heartbeatAt": {
         "description": "ISO-8601.",
         "type": "string"
        },
        "live": {
         "description": "Running on this replica.",
         "type": "boolean"
        },
        "phase": {
         "type": "string"
        },
        "startedAt": {
         "description": "ISO-8601.",
         "type": "string"
        },
        "status": {
         "description": "RUNNING or CANCELLING.",
         "type": "string"
        },
        "turnId": {
         "type": "integer"
        },
        "userMessageId": {
         "type": "integer"
        }
       },
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "AssistantConfigResponseV1": {
    "description": "Whether the assistant is available to this user, and how.",
    "properties": {
     "enabled": {
      "description": "Whether the panel may be used.",
      "type": "boolean"
     },
     "features": {
      "additionalProperties": true,
      "description": "writes: some table allows writes; pendingActions: writes wait for confirmation.",
      "type": "object"
     },
     "limits": {
      "additionalProperties": true,
      "description": "maxTurnSeconds and maxToolCallsPerTurn.",
      "type": "object"
     },
     "model": {
      "description": "The model that answers.",
      "type": "string"
     },
     "profile": {
      "$ref": "#/components/schemas/AssistantProfileV1"
     },
     "reason": {
      "description": "Why not: DISABLED, NO_PERMISSION, NOT_CONFIGURED or KILL_SWITCH.",
      "nullable": true,
      "type": "string"
     },
     "shortcut": {
      "description": "Keyboard shortcut, e.g. mod+j.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "AssistantConversationDetailResponseV1": {
    "description": "A conversation and a page of its messages, oldest first.",
    "properties": {
     "conversation": {
      "$ref": "#/components/schemas/AssistantConversationV1"
     },
     "messages": {
      "items": {
       "$ref": "#/components/schemas/AssistantMessageV1"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "AssistantConversationListResponseV1": {
    "description": "The user's conversations, newest first.",
    "properties": {
     "conversations": {
      "items": {
       "$ref": "#/components/schemas/AssistantConversationV1"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "AssistantConversationV1": {
    "description": "One of the user's own conversations.",
    "properties": {
     "createDate": {
      "description": "ISO-8601 instant.",
      "nullable": true,
      "type": "string"
     },
     "id": {
      "type": "integer"
     },
     "lastMessageAt": {
      "description": "ISO-8601 instant.",
      "nullable": true,
      "type": "string"
     },
     "pinned": {
      "type": "boolean"
     },
     "status": {
      "description": "ACTIVE or ARCHIVED.",
      "type": "string"
     },
     "title": {
      "nullable": true,
      "type": "string"
     },
     "unreadCount": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "AssistantErrorV1": {
    "description": "An error.",
    "properties": {
     "code": {
      "description": "BUDGET, RATE_LIMIT, NOT_CONFIGURED, KILL_SWITCH, DISABLED, NO_PERMISSION...",
      "nullable": true,
      "type": "string"
     },
     "error": {
      "description": "A message for the user.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "AssistantMessageV1": {
    "description": "A message: the user's text or the assistant's reply as parts (text, tool, record_refs, navigate, notice).",
    "properties": {
     "createDate": {
      "nullable": true,
      "type": "string"
     },
     "id": {
      "type": "integer"
     },
     "parts": {
      "items": {
       "additionalProperties": true,
       "description": "A message part.",
       "type": "object"
      },
      "type": "array"
     },
     "role": {
      "description": "USER or ASSISTANT.",
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "turnId": {
      "nullable": true,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "AssistantProfileV1": {
    "description": "How the assistant presents itself (admin-configured; text only, it never changes access).",
    "properties": {
     "displayName": {
      "description": "The assistant's name.",
      "type": "string"
     },
     "greeting": {
      "description": "Shown on a new conversation.",
      "nullable": true,
      "type": "string"
     },
     "icon": {
      "description": "A Material icon name.",
      "type": "string"
     },
     "starterPrompts": {
      "description": "Suggested first questions.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "AssistantStatusResponseV1": {
    "description": "An acknowledgement.",
    "properties": {
     "status": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "AssistantTurnEventV1": {
    "description": "One server-sent event of a turn (event: <type>, id: <seq>, data: this object). Types: message.start, turn.phase, text.delta, tool.start, tool.result, ui.navigate, notice, usage, message.end, error, ping.",
    "properties": {
     "data": {
      "additionalProperties": true,
      "description": "The event's fields, by type. message.start includes startedAt (ISO-8601). turn.phase includes phase (thinking, tool, writing), optional toolName and label.",
      "type": "object"
     },
     "seq": {
      "description": "Sequence number; resume with ?after=<seq>.",
      "type": "integer"
     },
     "type": {
      "description": "The event type (also the SSE event name).",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "securitySchemes": {
   "sessionUuidCookie": {
    "in": "cookie",
    "name": "sessionUUID",
    "type": "apiKey"
   }
  }
 },
 "info": {
  "contact": {
   "email": "contact@kingsrook.com"
  },
  "description": "QQQ Assistant: conversations, streamed turns, feedback, pending actions and data access explanations",
  "title": "QQQ Middleware API extension: assistant",
  "version": "1.2.0"
 },
 "openapi": "3.0.3",
 "paths": {
  "/qqq/v1/assistant/access": {
   "get": {
    "description": "Explain access: which UI API operations the assistant could call for this user, and why not",
    "parameters": [
     {
      "description": "Only this table.",
      "in": "query",
      "name": "table",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "description": "Only the tables this text mentions.",
      "in": "query",
      "name": "prompt",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "description": "Attribute this request to an owned turn.",
      "in": "query",
      "name": "turnId",
      "required": false,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantAccessResponseV1"
        }
       }
      },
      "description": "Successful Response"
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "Invalid input"
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "No access to the assistant"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "Not found (or not the user's own)"
     },
     "409": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "Already finished or decided"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "Budget or rate limit"
     },
     "503": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssistantErrorV1"
        }
       }
      },
      "description": "Disabled, not configured, or the kill switch is on"
     }
    },
    "security": [
     {
      "sessionUuidCookie": [
       "N/A"
      ]
     }
    ],
    "summary": "Explain access: which UI API operations the assistant could call for this user, and why not"
   }
  },
